{
  "schema_version": "1.0",
  "preprocessing_id": "rembg_u2net_gray_v1",
  "backend": "rembg",
  "model_name": "u2net",
  "model_dir": "models/preprocessing/rembg",
  "model_filename": "u2net.onnx",
  "output_size": [1024, 1024],
  "background_value": 128,
  "input_color_policy": "grayscale_replicated_to_rgb",
  "mask_threshold": 128,
  "mask_dilation_px": 0,
  "rembg_post_process_mask": false,
  "valid_mask_area_ratio": [0.2, 0.85],
  "fail_on_quality_flags": ["mask_area_out_of_range"],
  "keep_largest_component": true,
  "preserve_mask_holes": true,
  "bbox_padding_ratio": 0.01,
  "object_scale": 0.9,
  "object_center": [0.5, 0.48],
  "image_interpolation": "lanczos",
  "mask_interpolation": "nearest",
  "composite_mode": "hard_gray",
  "output_format": "png"
}
