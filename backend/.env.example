# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored and must never be committed.

# Port the FastAPI/uvicorn backend listens on. Defaults to 8000 if unset.
PORT=8000

# SMTP settings for alert emails. These override config.json at runtime;
# the password is sourced only from here and is never written to disk.
# For Gmail, use an App Password (Google Account > Security > App passwords).
# SMTP_USER defaults to jerryscan.ai@gmail.com if left unset.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jerryscan.ai@gmail.com
SMTP_PASSWORD=your-app-password
